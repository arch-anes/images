{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        "abandonments:recommended"
    ],
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/^docker-bake\\.hcl$/"
            ],
            "matchStrings": [
                "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)(?: versioning=(?<versioning>.*?))?\\s+variable \".*?\" {\\s+default = \"(?<currentValue>[^\"]+)\""
            ],
            "currentValueTemplate": "{{#if (equals depName 'ghcr.io/ggml-org/llama.cpp')}}server-rocm-{{{currentValue}}}{{else}}{{{currentValue}}}{{/if}}",
            "autoReplaceStringTemplate": "{{#if (equals depName 'ghcr.io/ggml-org/llama.cpp')}}{{replace 'server-rocm-' '' newValue}}{{else}}{{{newValue}}}{{/if}}"
        }
    ],
    "packageRules": [
        {
            "matchPackageNames": [
                "ghcr.io/ggml-org/llama.cpp"
            ],
            "versioning": "regex:^b(?<major>\\d+)$",
            "extractVersion": "^server-rocm-(?<version>b\\d+)$"
        },
        {
            "matchCategories": [
                "docker"
            ],
            "enabled": true
        },
        {
            "automerge": true,
            "automergeType": "pr",
            "automergeStrategy": "squash",
            "matchUpdateTypes": [
                "major",
                "minor",
                "patch",
                "pin",
                "digest"
            ],
            "matchDatasources": [
                "docker"
            ]
        }
    ]
}
